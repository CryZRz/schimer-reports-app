<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.Separator?>

<?import java.net.URL?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ScrollPane?>
<BorderPane
        xmlns:fx="http://javafx.com/fxml"
        fx:controller="com.schimer.reportsapp.controllers.guest.profile.DropboxLoginController"
>

    <stylesheets>
        <URL value="@../../../styles/guest/layout.css"/>
        <URL value="@../../../styles/components/default-inputs.css"/>
        <URL value="@../../../styles/components/default-texts.css"/>
        <URL value="@../../../styles/components/default-buttons.css"/>
        <URL value="@../../../styles/guest/profile/dropbox-login.css"/>
    </stylesheets>

    <left>
        <fx:include fx:id="sidebar" source="../sidebar-guest.fxml" />
    </left>

    <center>
        <VBox>
            <fx:include fx:id="sectionInfo" source="../../components/base-section-info.fxml"/>
            <Separator opacity="0.3"/>
            <ScrollPane fitToWidth="true" hbarPolicy="NEVER">
                <VBox styleClass="main-section-container">
                    <HBox>
                        <VBox HBox.hgrow="ALWAYS" styleClass="login-container" spacing="10">
                            <Label styleClass="login-title" text="Inicar sesion" />
                            <Label styleClass="login-description" text="Actualmente no tienes una sesión iniciada en el sistema, has click en el botón para poder iniciar sesión&#10; y seleccionar tu directorio de trabajo" />
                            <Button onAction="#onClickLogin" styleClass="primary-button">Iniciar sesion</Button>
                        </VBox>
                    </HBox>
                </VBox>
            </ScrollPane>
        </VBox>
    </center>
</BorderPane>
