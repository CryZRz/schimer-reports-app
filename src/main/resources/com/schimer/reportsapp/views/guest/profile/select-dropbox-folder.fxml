<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.Separator?>

<?import java.net.URL?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.control.ListView?>

<BorderPane
        xmlns:fx="http://javafx.com/fxml"
        fx:controller="com.schimer.reportsapp.controllers.guest.profile.SelectFolderDropboxController"
>

    <stylesheets>
        <URL value="@../../../styles/guest/layout.css"/>
        <URL value="@../../../styles/components/default-inputs.css"/>
        <URL value="@../../../styles/components/default-texts.css"/>
        <URL value="@../../../styles/components/default-buttons.css"/>
        <URL value="@../../../styles/guest/profile/dropbox-profile.css"/>
    </stylesheets>

    <left>
        <fx:include fx:id="sidebar" source="../sidebar-guest.fxml" />
    </left>

    <center>
        <VBox>
            <fx:include fx:id="sectionInfo" source="../../components/base-section-info.fxml"/>
            <Separator opacity="0.3"/>
            <ScrollPane styleClass="scroll-container" fitToWidth="true" hbarPolicy="NEVER">
                <VBox HBox.hgrow="ALWAYS" styleClass="main-section-container">
                    <VBox  maxWidth="Infinity" styleClass="info-account-container" spacing="8">
                        <Label fx:id="lblCurrentPath" text="Cargando..." wrapText="true"/>

                        <Button fx:id="btnUp" text="Atras" onAction="#handleGoUp" disable="true"/>

                        <ListView fx:id="folderListView" VBox.vgrow="ALWAYS"/>

                        <VBox spacing="10">
                            <Button styleClass="primary-button" fx:id="btnSelect" text="Seleccionar folder" onAction="#handleSelectFolder" maxWidth="Infinity"/>
                            <Button styleClass="cancel-button"  text="Cancelar" onAction="#handleCancel" maxWidth="Infinity"/>
                        </VBox>
                    </VBox>
                </VBox>
            </ScrollPane>
        </VBox>
    </center>
</BorderPane>
