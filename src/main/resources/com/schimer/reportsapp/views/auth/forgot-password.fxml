<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>

<HBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.schimer.reportsapp.controllers.auth.ForgotPasswordController"
      stylesheets="@../../styles/auth/forgotPassword.css"
>
    <VBox HBox.hgrow="ALWAYS" styleClass="forgot-password-container">
        <VBox styleClass="forgot-password-form-container">
            <VBox>
                <ImageView>
                    <Image url="@../../assets/images/schimer-logo-blue.png"/>
                </ImageView>
                <Label styleClass="title-form">Recuperar</Label>
                <Label styleClass="title-form">contraseña</Label>
                <Label styleClass="subtitle-form">Contesta el formulario para recuperar la cuenta</Label>
            </VBox>
            <VBox>
                <Label text="Correo" styleClass="input-label"/>
                <TextField promptText="Correo" styleClass="input-form"/>
            </VBox>
            <VBox>
                <Label text="¿Cual fue tu primer trabajo?" styleClass="input-label"/>
                <TextField promptText="Pregunta" styleClass="input-form"/>
            </VBox>
            <VBox>
                <Label text="¿Cual es el nombre de tu primer mascota?" styleClass="input-label"/>
                <TextField promptText="Pregunta" styleClass="input-form"/>
            </VBox>
            <VBox>
                <Label text="¿Cual es tu comida favortia?" styleClass="input-label"/>
                <TextField promptText="Pregunta" styleClass="input-form"/>
            </VBox>
            <Button HBox.hgrow="ALWAYS" maxWidth="Infinity" styleClass="cancel-button" onAction="#onClickBackToLogin">
                Regresar
            </Button>
            <Button HBox.hgrow="ALWAYS" maxWidth="Infinity" styleClass="forgot-button" onAction="#onClickForgotPassword">
                Recuperar contraseña
            </Button>
        </VBox>
    </VBox>
    <VBox HBox.hgrow="ALWAYS" styleClass="forgot-password-image"/>
</HBox>
