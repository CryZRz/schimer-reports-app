<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox
        xmlns:fx="http://javafx.com/fxml"
        fx:controller="com.schimer.reportsapp.controllers.components.BaseSectionInfo"
        stylesheets="@../../styles/guest/section-pt-info.css"
>
    <fx:include source="../components/header.fxml"/>
    <HBox>
        <VBox HBox.hgrow="ALWAYS" styleClass="info-module-container">
            <HBox alignment="CENTER_LEFT">
                <Label fx:id="titleModule" text="Producto Terminado" styleClass="title-module"/>
                <Region HBox.hgrow="ALWAYS"/>
            </HBox>
            <Label fx:id="descriptionModule" styleClass="description-module" text="Esta seccion esta destinada a la administracion &#10; de los productos terminados"/>
        </VBox>
    </HBox>
</VBox>