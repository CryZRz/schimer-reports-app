<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE hibernate-configuration PUBLIC
        "-//Hibernate/Hibernate Configuration DTD 3.0//EN"
        "http://www.hibernate.org/dtd/hibernate-configuration-3.0.dtd">
<hibernate-configuration>
    <session-factory>
        <property name="connection.driver_class">org.postgresql.Driver</property>
        <property name="connection.url">jdbc:postgresql://localhost:5432/schimerapp</property>
        <property name="connection.username">user</property>
        <property name="connection.password">password</property>

        <property name="dialect">org.hibernate.dialect.PostgreSQLDialect</property>

        <property name="hbm2ddl.auto">validate</property>

        <property name="show_sql">true</property>
        <property name="format_sql">true</property>

        <mapping class="com.schimer.reportsapp.domain.entities.UserEntity"/>
        <mapping class="com.schimer.reportsapp.domain.entities.RoleEntity"/>
        <mapping class="com.schimer.reportsapp.domain.entities.QuestionEntity"/>
        <mapping class="com.schimer.reportsapp.domain.entities.QuestionResponseEntity"/>
        <mapping class="com.schimer.reportsapp.domain.entities.DepartmentEntity"/>
        <mapping class="com.schimer.reportsapp.domain.entities.DropboxAccountEntity"/>
        <mapping class="com.schimer.reportsapp.domain.entities.EmailAccountEntity"/>
        <mapping class="com.schimer.reportsapp.domain.entities.ProductFinishedEntity"/>
        <mapping class="com.schimer.reportsapp.domain.entities.PtQualityCertificateEntity"/>
        <mapping class="com.schimer.reportsapp.domain.entities.PtQualityCertificateDetailEntity"/>
        <mapping class="com.schimer.reportsapp.domain.entities.PtQualityIndicatorsEntity"/>
        <mapping class="com.schimer.reportsapp.domain.entities.PtQualitySolidLiquidEntity"/>
        <mapping class="com.schimer.reportsapp.domain.entities.TemplateEntity"/>
        <mapping class="com.schimer.reportsapp.domain.entities.rawMaterial.TemplateRawMaterialEntity"/>
        <mapping class="com.schimer.reportsapp.domain.entities.rawMaterial.RawMaterialEntity"/>
        <mapping class="com.schimer.reportsapp.domain.entities.rawMaterial.RawMaterialReleaseEntity"/>
        <mapping class="com.schimer.reportsapp.domain.entities.rawMaterial.QualityParameterRawMaterialRelease"/>
    </session-factory>
</hibernate-configuration>